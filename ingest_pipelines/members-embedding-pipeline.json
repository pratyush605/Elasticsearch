              "output_field": "BUSINESS_DOMAIN_VECTOR"
            },
            {
              "input_field": "COMPLIANCE_TEXT",
              "output_field": "COMPLIANCE_VECTOR"
            },
            {
              "input_field": "GEOGRAPHY_TEXT",
              "output_field": "GEOGRAPHY_VECTOR"
            },
            {
              "input_field": "IDENTITY_TEXT",
              "output_field": "IDENTITY_VECTOR"
