{
  "settings": {
    "max_result_window": 1000000,
    "analysis": {
      "analyzer": {
        "case_insensitive": {
          "type": "custom",
          "tokenizer": "keyword",
          "filter": [
            "lowercase"
          ]
        },
        "lowercase_stop_analyzer": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": [
            "lowercase",
            "stop"
          ]
        }
      },
      "normalizer": {
        "lowercase_normalizer": {
          "type": "custom",
          "filter": [
            "lowercase"
          ]
        }
      }
    }
  },
  "mappings": {
    "dynamic_templates": [
      {
        "en": {
          "match_mapping_type": "string",
          "match": "*",
          "mapping": {
            "type": "text",
            "analyzer": "english",
            "fields": {
              "keyword": {
                "type": "keyword",
                "ignore_above": 256
              }
            }
          }
        }
      }
    ],
    "properties": {
      "ADDDATE": {
        "type": "date",
        "format": "strict_date_optional_time"
      },
      "ADDRESS1": {
        "type": "text",
        "analyzer": "english"
      },
      "ADDRESS2": {
        "type": "text",
        "analyzer": "english"
      },
      "ADDRESS3": {
        "type": "text",
        "analyzer": "english"
      },
      "ADDRESS4": {
        "type": "text",
        "analyzer": "english"
      },
      "AUTOMATED_SPAM_FLAG": {
        "type": "long"
      },
      "CAN_RECVINQ": {
        "type": "long"
      },
      "CATG_CODE": {
        "type": "keyword"
      },
      "CATG_TYPE": {
        "type": "keyword"
      },
      "CITY": {
        "type": "text",
        "analyzer": "english"
      },
      "CLIENT_ID": {
        "type": "text",
        "analyzer": "english"
      },
      "COMPNAME": {
